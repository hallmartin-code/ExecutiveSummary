# Copy to .env for local use, or set these as variables in the Railway dashboard.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# Anthropic (required for the full AI pipeline)
# ---------------------------------------------------------------------------
# Your key from https://console.anthropic.com/ -> API keys.
# Without it the app still runs, using heuristic extraction and deterministic
# composition, but the output is noticeably thinner.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---------------------------------------------------------------------------
# Web deployment
# ---------------------------------------------------------------------------

# Shared password gate. Unset means the URL is open to anyone who has it.
# Strongly recommended for a public deployment, since pitch decks are confidential.
# APP_PASSWORD=choose-a-long-random-passphrase

# Show an API-key field in the UI so a visitor can spend their own credits
# instead of the deployment's.
# ALLOW_USER_API_KEY=true

# Go further: hide the server key entirely and require every visitor to bring
# their own. Use this if you do not want to fund other people's runs.
# REQUIRE_USER_API_KEY=true

# Per-file upload limit in megabytes (default 80). Keep .streamlit/config.toml's
# maxUploadSize greater than or equal to this.
# MAX_UPLOAD_MB=80

# Maximum slides accepted in a deck (default 120).
# MAX_DECK_PAGES=120

# Where generated files are written. On Railway this defaults to a temp directory
# because the container filesystem is ephemeral; files reach the user through the
# download buttons.
# OUTPUT_DIR=/tmp/execsummary_output

# Show Python tracebacks in the UI. Off by default on a managed deployment so
# server paths are not exposed.
# SHOW_TRACEBACKS=false

# Set automatically by Railway. Set it manually only to force deployment
# behaviour (temp output directory, hidden tracebacks) during local testing.
# MANAGED_DEPLOYMENT=true

# PORT is injected by Railway at runtime. Do not set it yourself.

# ---------------------------------------------------------------------------
# Result notifications (Resend)
# ---------------------------------------------------------------------------
# Emails every completed run, with the one-pager PDF and the audit JSON attached.
# This sends deck-derived content to Resend and to the recipient's inbox, and the
# UI discloses it. Leave RESEND_API_KEY unset to keep notifications off.
# RESEND_API_KEY=re_your_key_here

# Where results are sent. Comma-separate for several recipients.
# NOTIFY_EMAIL_TO=Info@tencapital.group

# The sending domain must be VERIFIED in Resend, otherwise sends fail with a 403.
# NOTIFY_EMAIL_FROM=TEN Capital Executive Summary <noreply@tencapital.group>

# Attach the audit JSON as well as the PDF (default true).
# NOTIFY_ATTACH_ANALYSIS=true

# Force notifications on or off regardless of the key being present.
# EMAIL_NOTIFICATIONS=true
